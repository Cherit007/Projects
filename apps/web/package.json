{
  "name": "@fixture-maker/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node ../../scripts/copy-documentation.mjs",
    "test": "vitest",
    "test:run": "vitest run",
