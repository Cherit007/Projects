{
  "homepage": "https://Cherit007.github.io/Projects",
  "name": "badminton-fixture-maker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "npm run dev -w @fixture-maker/web",
    "dev:mobile": "npm run start:clear -w @fixture-maker/mobile",
    "build": "npm run build -w @fixture-maker/web",
    "test": "npm run test -w @fixture-maker/web",
    "test:run": "npm run test:run -w @fixture-maker/web && npm run test:run -w @fixture-maker/mobile",
    "e2e:pickleball": "playwright test --grep @pickleball",
    "e2e:scoring": "playwright test --grep @scoring",
    "e2e:offline": "playwright test --grep @offline",
    "e2e:auth": "playwright test --grep @auth",
    "e2e:headed": "playwright test --headed",
    "e2e:ui": "playwright test --ui",
    "lint": "eslint scripts packages eslint.config.js apps/web/vite.config.js playwright.config.js",
    "lint:web": "eslint apps/web/src --max-warnings 15",
    "validate:normalized": "node scripts/migration/validate-normalized.mjs",
    "validate:normalized:dry-run": "node scripts/migration/validate-normalized.mjs --dry-run",
    "migration:sport-id:dry-run": "node scripts/migration/backfill-sport-id.mjs",
    "migration:sport-id:apply": "node scripts/migration/backfill-sport-id.mjs --apply",
    "turbo:build": "turbo run build",
    "turbo:test": "turbo run test:run",
    "turbo:lint": "turbo run lint",
    "migration:groups:dry-run": "node scripts/migration/migrate-group-domain-from-app-meta.mjs",
    "migration:groups:apply": "node scripts/migration/migrate-group-domain-from-app-meta.mjs --apply",
    "design:mockups": "node scripts/design/generate-mockups-api.mjs",
    "design:mockups:dry-run": "node scripts/design/generate-mockups-api.mjs --dry-run",
    "design:mockups:web": "node scripts/design/gemini-web-generate.mjs",
    "design:mockups:web:login": "node scripts/design/gemini-web-generate.mjs --login",
    "design:prompts:export": "node scripts/design/export-prompts.mjs",
    "preview": "npm run preview -w @fixture-maker/web",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d docs -b badminton-v5 -f"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@google/genai": "^1.52.0",
    "@playwright/test": "^1.58.2",
    "autoprefixer": "^10.4.24",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "gh-pages": "^6.3.0",
    "globals": "^16.5.0",
    "postcss": "^8.5.6"
  }
}
