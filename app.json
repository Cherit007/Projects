{
  "expo": {
    "name": "FinanceTracker",
    "slug": "FinanceTracker",
    "scheme": "financetracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cherit.financetracker"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.cherit.financetracker"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-web-browser",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Attach a photo of a receipt to a transaction. Photos stay on this device.",
          "cameraPermission": "Take a photo of a receipt to attach to a transaction. Photos stay on this device.",
          "microphonePermission": false
        }
      ],
      "./modules/bank-sms/app.plugin.js",
      "./plugins/withIosSceneLifecycle.js"
    ]
  }
}
