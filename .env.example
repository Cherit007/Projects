# Copy to .env.local and fill in. Never commit .env.local.
# EXPO_PUBLIC_* values are bundled into the app and visible to users, so only
# put public client identifiers here. Never add an Appwrite API key.
#
# Leave the project ID empty to run fully offline (sync and sign-in are hidden).
# Use the endpoint shown in your Appwrite project settings, e.g. https://fra.cloud.appwrite.io/v1

EXPO_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
EXPO_PUBLIC_APPWRITE_PROJECT_ID=
