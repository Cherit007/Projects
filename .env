# Appwrite Cloud Configuration
# Copy this file to .env and fill in your actual values

# Appwrite Endpoint (use cloud or self-hosted)
VITE_APPWRITE_ENDPOINT=https://nyc.cloud.appwrite.io/v1

# Your Appwrite Project ID (from Appwrite Console)
VITE_APPWRITE_PROJECT_ID=69916a1f0034b93fdd9a

# Your Database ID (from Appwrite Console > Databases)
VITE_APPWRITE_DATABASE_ID=69916a380029c82fc418

# Collection IDs (create these in Appwrite Console > Database > Collections)
VITE_APPWRITE_COLLECTION_TOURNAMENTS=tournaments
VITE_APPWRITE_COLLECTION_PLAYERS=players
VITE_APPWRITE_COLLECTION_RATINGS=ratings
VITE_APPWRITE_COLLECTION_CASUAL_MATCHES=casualmatches
VITE_APPWRITE_COLLECTION_APP_META=app_meta
VITE_APPWRITE_COLLECTION_SESSION_STATE=session_state
VITE_APPWRITE_BUCKET_PLAYER_PHOTOS=699f53cc002ac8e00a61

# Normalized V2 collection IDs (runtime app uses these after cutover)
VITE_APPWRITE_COLLECTION_V2_PLAYERS=v2_players
VITE_APPWRITE_COLLECTION_V2_TOURNAMENTS=v2_tournaments
VITE_APPWRITE_COLLECTION_V2_TOURNAMENT_TEAMS=tournament_teams
VITE_APPWRITE_COLLECTION_V2_MATCHES=matches
VITE_APPWRITE_COLLECTION_V2_MATCH_PLAYERS=match_players
VITE_APPWRITE_COLLECTION_V2_RATINGS_CURRENT=ratings_current

# Normalized group collections (optional cutover from app_meta JSON envelope)
# VITE_APPWRITE_COLLECTION_GROUPS=groups
# VITE_APPWRITE_COLLECTION_GROUP_MEMBERS=group_members
# VITE_APPWRITE_COLLECTION_GROUP_INVITES=group_invites
# VITE_APPWRITE_COLLECTION_GROUP_JOIN_REQUESTS=group_join_requests
# VITE_APPWRITE_COLLECTION_GROUP_ACTIVE_LOCKS=group_active_locks


# Optional: Add these for production
# VITE_APPWRITE_API_KEY=

# Notes:
# - All environment variables must start with VITE_ for Vite to expose them
# - Never commit the .env file to git (add it to .gitignore)
# - After adding/changing env vars, restart your dev server
# ------------------------------------------------------------
# Appwrite migration (server-side scripts only)
# Used by scripts in scripts/migration/*
# ------------------------------------------------------------
APPWRITE_ENDPOINT=
APPWRITE_PROJECT_ID=
APPWRITE_DATABASE_ID=
APPWRITE_API_KEY=standard_8e7b3bc383b91240f4b2d115713dafa3c6cd9b67429ebf00d736ae9b05b761f1ddd6aad4df2d97c9a6c2dbe50a751d1620b489e09b567f1b41c6befe0e211a8a2f5ffee09ce557bb24456cc178bbfa176faab2526343ded39b47da7d533ad75be7c1973074695dd9c054ed4a6fdecba193a1f28dae3fa13c225d5159e1e3c63c

# Legacy collection IDs (for backup/export)
APPWRITE_COLLECTION_TOURNAMENTS=
APPWRITE_COLLECTION_PLAYERS=
APPWRITE_COLLECTION_RATINGS=
APPWRITE_COLLECTION_CASUAL_MATCHES=
APPWRITE_COLLECTION_APP_META=

# Normalized v2 collection IDs (for backfill/validation)
APPWRITE_COLLECTION_V2_PLAYERS=v2_players
APPWRITE_COLLECTION_V2_TOURNAMENTS=v2_tournaments
APPWRITE_COLLECTION_V2_TOURNAMENT_TEAMS=tournament_teams
APPWRITE_COLLECTION_V2_MATCHES=matches
APPWRITE_COLLECTION_V2_MATCH_PLAYERS=match_players
APPWRITE_COLLECTION_V2_RATINGS_CURRENT=ratings_current


VITE_APPWRITE_COLLECTION_GROUPS=groups
VITE_APPWRITE_COLLECTION_GROUP_MEMBERS=group_members
VITE_APPWRITE_COLLECTION_GROUP_INVITES=group_invites
VITE_APPWRITE_COLLECTION_GROUP_JOIN_REQUESTS=group_join_requests
VITE_APPWRITE_COLLECTION_GROUP_ACTIVE_LOCKS=group_active_locks
VITE_APPWRITE_COLLECTION_TOURNAMENT_TEMPLATES=tournament_templates
VITE_APPWRITE_COLLECTION_GROUP_ROSTER=group_roster