# Appwrite Cloud Configuration
# Copy this file to .env and fill in your actual values

# Appwrite Endpoint (use cloud or self-hosted)
VITE_APPWRITE_ENDPOINT=https://nyc.cloud.appwrite.io/v1

# Your Appwrite Project ID (from Appwrite Console)
VITE_APPWRITE_PROJECT_ID=69916a1f0034b93fdd9a

# Your Database ID (from Appwrite Console > Databases)
VITE_APPWRITE_DATABASE_ID=69916a380029c82fc418

# Collection IDs (create these in Appwrite Console > Database > Collections)
VITE_APPWRITE_COLLECTION_TOURNAMENTS=tournaments
VITE_APPWRITE_COLLECTION_PLAYERS=players
VITE_APPWRITE_COLLECTION_RATINGS=ratings
VITE_APPWRITE_COLLECTION_CASUAL_MATCHES=casualmatches
VITE_APPWRITE_COLLECTION_APP_META=app_meta
VITE_APPWRITE_COLLECTION_SESSION_STATE=session_state
VITE_APPWRITE_BUCKET_PLAYER_PHOTOS=699f53cc002ac8e00a61
# Optional: Add these for production
# VITE_APPWRITE_API_KEY=

# Notes:
# - All environment variables must start with VITE_ for Vite to expose them
# - Never commit the .env file to git (add it to .gitignore)
# - After adding/changing env vars, restart your dev server